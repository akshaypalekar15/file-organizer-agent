# Optional — only needed for headless/CI runs.
# The app's Settings dialog takes priority over both of these; it stores your
# key encrypted in your OS keychain, which is the recommended way to configure it.
OPENROUTER_API_KEY=

# Optional: model used when the dialog has not set one.
# Full catalog: https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# Optional: your site URL, used only for OpenRouter app attribution/rankings.
OPENROUTER_SITE_URL=
